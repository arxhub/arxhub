{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArxHub",
  "version": "../package.json",
  "identifier": "org.arxhub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArxHub",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.arxhub/**",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "app",
      "dmg",
      "nsis"
    ],
    "publisher": "rougsig",
    "copyright": "Copyright © rougsig",
    "category": "Productivity",
    "license": "AGPL-3.0-or-later",
    "shortDescription": "Modular personal knowledge base",
    "longDescription": "ArxHub is a local-first personal knowledge base: your notes stay on your devices and sync end-to-end encrypted through a server you own.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
