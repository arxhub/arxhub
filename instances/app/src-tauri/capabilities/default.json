{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "os:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/.arxhub"
        },
        {
          "path": "$HOME/.arxhub/*"
        },
        {
          "path": "$HOME/.arxhub/**"
        },
        {
          "path": "$HOME/.arxhub/.*"
        },
        {
          "path": "$HOME/.arxhub/**/.*"
        },
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/*"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPDATA/.*"
        },
        {
          "path": "$APPDATA/**/.*"
        }
      ]
    }
  ]
}
