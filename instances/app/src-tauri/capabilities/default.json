{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/ArxHub/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    "os:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/ArxHub"
        },
        {
          "path": "$HOME/ArxHub/*"
        },
        {
          "path": "$HOME/ArxHub/**"
        },
        {
          "path": "$HOME/ArxHub/.*"
        },
        {
          "path": "$HOME/ArxHub/**/.*"
        },
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/*"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPDATA/.*"
        },
        {
          "path": "$APPDATA/**/.*"
        }
      ]
    }
  ]
}
