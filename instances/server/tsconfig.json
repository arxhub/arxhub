{
  "extends": "@arxhub/toolchain-tsconfig",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    /* The base names no runtime; this one is Node, and DOM carries the fetch/Web types Elysia builds on. */
    "lib": ["esnext", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
