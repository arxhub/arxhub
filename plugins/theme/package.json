{
  "name": "@arxhub/plugin-theme",
  "sideEffects": false,
  "version": "0.1.0",
  "description": "Theme registry and picker — themes are whole units, selected at runtime",
  "keywords": [
    "arxhub"
  ],
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./ui": "./src/ui.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build"
  },
  "dependencies": {
    "@arxhub/config": "workspace:*",
    "vue": "catalog:client"
  },
  "devDependencies": {
    "@arxhub/toolchain-tsconfig": "workspace:*",
    "@arxhub/toolchain-vite": "workspace:*",
    "@sinclair/typebox": "catalog:shared",
    "@types/node": "catalog:toolchain"
  },
  "peerDependencies": {
    "@arxhub/core": "workspace:*",
    "@arxhub/plugin-settings": "workspace:*",
    "@arxhub/uikit": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      "./ui": {
        "import": "./dist/ui.js",
        "types": "./dist/ui.d.ts"
      }
    }
  }
}
