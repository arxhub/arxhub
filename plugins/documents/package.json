{
  "name": "@arxhub/plugin-documents",
  "sideEffects": false,
  "version": "0.1.0",
  "description": "Documents tab type for ArxHub: the object type and its viewer registry",
  "keywords": [
    "arxhub"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./ui": "./src/ui.ts",
    "./type": "./src/documents-type.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest"
  },
  "dependencies": {
    "@arxhub/config": "workspace:*",
    "@arxhub/path": "workspace:*",
    "@sinclair/typebox": "catalog:shared",
    "vue": "catalog:client",
    "@arxhub/i18n": "workspace:*"
  },
  "devDependencies": {
    "@arxhub/core": "workspace:*",
    "@arxhub/di": "workspace:*",
    "@arxhub/events": "workspace:*",
    "@arxhub/errors": "workspace:*",
    "@arxhub/logger": "workspace:*",
    "@arxhub/plugin-settings": "workspace:*",
    "@arxhub/plugin-shell": "workspace:*",
    "@arxhub/vfs": "workspace:*",
    "@arxhub/vfs-node": "workspace:*",
    "@arxhub/toolchain-tsconfig": "workspace:*",
    "@arxhub/toolchain-vite": "workspace:*",
    "@types/node": "catalog:toolchain"
  },
  "peerDependencies": {
    "@arxhub/core": "workspace:*",
    "@arxhub/errors": "workspace:*",
    "@arxhub/plugin-repository": "workspace:*",
    "@arxhub/plugin-settings": "workspace:*",
    "@arxhub/plugin-shell": "workspace:*",
    "@arxhub/uikit": "workspace:*",
    "@arxhub/vfs": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./manifest": {
        "import": "./dist/manifest.js",
        "types": "./dist/manifest.d.ts"
      },
      "./ui": {
        "import": "./dist/ui.js",
        "types": "./dist/ui.d.ts"
      },
      "./type": {
        "import": "./dist/documents-type.js",
        "types": "./dist/documents-type.d.ts"
      }
    }
  }
}
