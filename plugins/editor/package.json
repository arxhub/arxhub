{
  "name": "@arxhub/plugin-editor",
  "sideEffects": [
    "**/*.css"
  ],
  "version": "0.1.0",
  "description": "ProseMirror note editor plugin for ArxHub",
  "keywords": [
    "arxhub"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "",
  "type": "module",
  "exports": {
    "./ui": "./src/ui.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest"
  },
  "dependencies": {
    "prosemirror-tables": "catalog:client",
    "@codemirror/language": "catalog:client",
    "@codemirror/language-data": "catalog:client",
    "@lezer/highlight": "catalog:client",
    "prosemirror-model": "catalog:client",
    "prosemirror-state": "catalog:client",
    "prosemirror-view": "catalog:client",
    "prosemirror-commands": "catalog:client",
    "prosemirror-history": "catalog:client",
    "prosemirror-inputrules": "catalog:client",
    "prosemirror-keymap": "catalog:client",
    "prosemirror-schema-basic": "catalog:client",
    "prosemirror-schema-list": "catalog:client",
    "mdast-util-from-markdown": "catalog:client",
    "mdast-util-gfm": "catalog:client",
    "micromark-extension-gfm": "catalog:client",
    "vue": "catalog:client"
  },
  "devDependencies": {
    "@arxhub/logger": "workspace:*",
    "@arxhub/toolchain-tsconfig": "workspace:*",
    "@arxhub/toolchain-vite": "workspace:*",
    "@types/mdast": "catalog:toolchain",
    "@types/node": "catalog:toolchain"
  },
  "peerDependencies": {
    "@arxhub/core": "workspace:*",
    "@arxhub/errors": "workspace:*",
    "@arxhub/path": "workspace:*",
    "@arxhub/plugin-explorer": "workspace:*",
    "@arxhub/plugin-hotkeys": "workspace:*",
    "@arxhub/plugin-notes": "workspace:*",
    "@arxhub/plugin-panels": "workspace:*",
    "@arxhub/plugin-search": "workspace:*",
    "@arxhub/plugin-shell": "workspace:*",
    "@arxhub/stdlib": "workspace:*",
    "@arxhub/uikit": "workspace:*",
    "@arxhub/vfs": "workspace:*",
    "@arxhub/crypto": "workspace:*",
    "@arxhub/plugin-protection": "workspace:*",
    "@arxhub/plugin-publish": "workspace:*",
    "@arxhub/plugin-repository": "workspace:*",
    "@arxhub/sync": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      "./ui": {
        "import": "./dist/ui.js",
        "types": "./dist/ui.d.ts"
      }
    }
  }
}
