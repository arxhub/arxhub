{
  "name": "@arxhub/plugin-sync",
  "sideEffects": false,
  "version": "0.1.0",
  "description": "Sync plugin for ArxHub — the remote exchange layered over the local repository",
  "keywords": [
    "arxhub"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "",
  "type": "module",
  "exports": {
    "./ui": "./src/ui.ts",
    "./server": "./src/server.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest"
  },
  "dependencies": {
    "@arxhub/config": "workspace:*",
    "vue": "catalog:client"
  },
  "devDependencies": {
    "@arxhub/vfs": "workspace:*",
    "@arxhub/logger": "workspace:*",
    "@arxhub/toolchain-tsconfig": "workspace:*",
    "@arxhub/toolchain-vite": "workspace:*",
    "@sinclair/typebox": "catalog:shared",
    "@types/node": "catalog:toolchain"
  },
  "peerDependencies": {
    "@arxhub/core": "workspace:*",
    "@arxhub/crypto": "workspace:*",
    "@arxhub/errors": "workspace:*",
    "@arxhub/plugin-gateway": "workspace:*",
    "@arxhub/plugin-protection": "workspace:*",
    "@arxhub/plugin-repository": "workspace:*",
    "@arxhub/plugin-settings": "workspace:*",
    "@arxhub/plugin-shell": "workspace:*",
    "@arxhub/sync": "workspace:*",
    "@arxhub/uikit": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      "./ui": {
        "import": "./dist/ui.js",
        "types": "./dist/ui.d.ts"
      },
      "./server": {
        "import": "./dist/server.js",
        "types": "./dist/server.d.ts"
      }
    }
  }
}
