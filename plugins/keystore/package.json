{
  "name": "@arxhub/plugin-keystore",
  "sideEffects": false,
  "version": "0.1.0",
  "description": "Client-local secure key/secret storage for ArxHub (localStorage today; keychain/IndexedDB later)",
  "keywords": [
    "arxhub"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./ui": "./src/ui.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest"
  },
  "dependencies": {
    "@arxhub/crypto": "workspace:*",
    "@noble/hashes": "catalog:shared",
    "@sinclair/typebox": "catalog:shared",
    "vue": "catalog:client"
  },
  "devDependencies": {
    "@arxhub/toolchain-tsconfig": "workspace:*",
    "@arxhub/toolchain-vite": "workspace:*",
    "@types/node": "catalog:toolchain"
  },
  "peerDependencies": {
    "@arxhub/core": "workspace:*",
    "@arxhub/errors": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./manifest": {
        "import": "./dist/manifest.js",
        "types": "./dist/manifest.d.ts"
      },
      "./ui": {
        "import": "./dist/ui.js",
        "types": "./dist/ui.d.ts"
      }
    }
  }
}
