{
  "name": "@arxhub/plugin-repository",
  "sideEffects": false,
  "version": "0.1.0",
  "description": "The local repository: manifest chain, chunk store, checkout index and file history — essential, sync-independent",
  "keywords": [
    "arxhub"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest"
  },
  "dependencies": {
    "@arxhub/config": "workspace:*",
    "vue": "catalog:client"
  },
  "devDependencies": {
    "@arxhub/logger": "workspace:*",
    "@arxhub/toolchain-tsconfig": "workspace:*",
    "@arxhub/toolchain-vite": "workspace:*",
    "@arxhub/vfs-node": "workspace:*",
    "@sinclair/typebox": "catalog:shared",
    "@types/node": "catalog:toolchain"
  },
  "peerDependencies": {
    "@arxhub/core": "workspace:*",
    "@arxhub/errors": "workspace:*",
    "@arxhub/path": "workspace:*",
    "@arxhub/plugin-protection": "workspace:*",
    "@arxhub/plugin-settings": "workspace:*",
    "@arxhub/sync": "workspace:*",
    "@arxhub/vfs": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "./manifest": {
        "import": "./dist/manifest.js",
        "types": "./dist/manifest.d.ts"
      }
    }
  }
}
