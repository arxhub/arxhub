{
  "name": "@arxhub/plugin-protection",
  "sideEffects": false,
  "version": "0.1.0",
  "description": "Identity, content-encryption keys, and request authentication for ArxHub",
  "keywords": [
    "arxhub"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "",
  "type": "module",
  "exports": {
    "./ui": "./src/ui.ts",
    "./server": "./src/server.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest"
  },
  "dependencies": {
    "@arxhub/config": "workspace:*",
    "@arxhub/crypto": "workspace:*",
    "@sinclair/typebox": "catalog:shared",
    "elysia": "catalog:server"
  },
  "devDependencies": {
    "@arxhub/toolchain-tsconfig": "workspace:*",
    "@arxhub/toolchain-vite": "workspace:*",
    "@types/node": "catalog:toolchain"
  },
  "peerDependencies": {
    "@arxhub/core": "workspace:*",
    "@arxhub/plugin-gateway": "workspace:*",
    "@arxhub/plugin-settings": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      "./ui": {
        "import": "./dist/ui.js",
        "types": "./dist/ui.d.ts"
      },
      "./server": {
        "import": "./dist/server.js",
        "types": "./dist/server.d.ts"
      }
    }
  }
}
